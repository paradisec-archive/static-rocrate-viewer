{"@context":["https://w3id.org/ro/crate/1.2-DRAFT/context",{"@vocab":"http://schema.org/"},"http://purl.archive.org/language-data-commons/context.json",{"Geometry":"http://www.opengis.net/ont/geosparql#Geometry","asWKT":"http://www.opengis.net/ont/geosparql#asWKT"},"https://w3id.org/ldac/context"],"@graph":[{"@id":"http://example.org/repository/NT1","@type":["Data","Object","RepositoryCollection"],"conformsTo":{"@id":"https://w3id.org/ldac/profile#Collection"},"additionalType":"collection","identifier":[{"@id":"#identifier_domain"},{"@id":"#identifier_id"},{"@id":"#identifier_itemIdentifier"},{"@id":"#identifier_doi"}],"name":"South Efate (Vanuatu)","description":"Records in this collection were made during fieldwork, mainly in Erakor Village, Efate, Vanuatu since 1996. They consist of audio recordings of South Efate speakers, originally on audio cassettes (hence there are often A and B sides of a single item). There is a total of over 40 hours of language material, and the collection includes time-aligned transcripts in Elan for many recordings, and interlinear text for a small proportion of them. It also includes field notes. The material here is the basis for Thieberger's grammar of South Efate which also cites primary material in this collection. Where there is a transcript the file has the same name as the recording with a .txt extension. These transcriptions are not as accurate as the versions that are found in the interlinear annotation, and also have relics of earlier transcription conventions (p$ and m$ for coarticulated p̃ and m̃). \r\nMany of these transcripts have then been interlinearised in the version that can be found in NT8. More recordings and other material in South Efate can be found in collections NT1 to NT7 in PARADISEC. A description of the collections is given here: https://www.nthieberger.net/sefate.html","contentLocation":[{"@id":"#place-Erakor, Eratap, Lelepa"}],"dateCreated":"2012-09-27","dateModified":"2025-01-29","datePublished":"2025-01-29","publisher":{"@id":"http://nla.gov.au/nla.party-479603"},"inLanguage":[{"@id":"#language-bis"},{"@id":"#language-erk"},{"@id":"#language-lpa"}],"subjectLanguages":[{"@id":"#language-erk"},{"@id":"#language-lpa"},{"@id":"#language-bis"}],"countries":[{"@id":"#country-Vanuatu"}],"comment":"Collection digitised in 2001. NICK THIEBERGER COLLECTION DATA  51 CDs, total of 38 hours of language material original medium: audio cassette date of recordings: 1996-2000  All burned as .AIFF data CDs. Archive copy of each CD in .AIFF data format.","private":false,"paradisec:admins":[{"@id":"http://nla.gov.au/nla.party-479603"},{"@id":"http://nla.gov.au/nla.party-783591"},{"@id":"mailto:thieberg@hawaii.edu"},{"@id":"mailto:amanda.harris@paradisec.org.au"},{"@id":"0000-0001-8797-1018"}],"license":{"@id":"#license-1"},"sourceOrganization":"http://nla.gov.au/nla.party-593909","orthographic_notes":"p$ and m$ are co-articulated labio-velars","paradisec:metadataSource":"depositor","itemLocation":"returned to depositor","about":"https://linked.data.gov.au/def/anzsrc-for/2020/200320","funder":[{"@id":"#grant-3"},{"@id":"#grant-64"},{"@id":"#grant-72"}]},{"@id":"ro-crate-metadata.json","@type":"CreativeWork","conformsTo":{"@id":"https://w3id.org/ro/crate/1.2-DRAFT"},"about":{"@id":"http://example.org/repository/NT1"}},{"@id":"#identifier_domain","@type":"PropertyValue","name":"domain","value":"paradisec.org.au"},{"@id":"#identifier_id","@type":"PropertyValue","name":"id","value":"NT1"},{"@id":"#identifier_itemIdentifier","@type":"PropertyValue","name":"itemIdentifier","value":"NT1"},{"@id":"#identifier_doi","@type":"PropertyValue","name":"doi","value":"10.4225/72/56E97595B6D0A"},{"@id":"#country-Vanuatu","@type":"Country","code":"VU","name":"Vanuatu"},{"@id":"#license-1","@type":"CreativeWork","name":"Open (subject to agreeing to PDSC access conditions)"},{"@id":"http://nla.gov.au/nla.party-479603","@type":"Person","familyName":"Thieberger","givenName":"Nick","name":"Nick Thieberger",