    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" TIER_ID="Transcription-txt-msn">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>O snel ni rererev tek na taqan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a6" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>E ni tēqēl ... tēqēl me lo vo ine, ni ēl o boks.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>E ni rerev kal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>Rev kal, rev kal, rev kal vaavan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a16" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>E dēn̄ ren siag lē m̄ēkē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a8" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>E ni rev, ni ... in̄ko ni wiak, wo ni ma kal lö lölö, e qēt.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="m" PARENT_REF="Transcription-txt-msn" TIER_ID="Words-txt-msn"/>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="f" PARENT_REF="Transcription-txt-msn" TIER_ID="Translation-gls-en">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a9" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>The snail is crawling on its belly.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>And it moves down, down to the thing, it sees a box.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a17" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>And it's crawling up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Crawls up, crawls up, crawls further up.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>And it reaches the top.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>And it crawls, it ... now [the box] opens, and [the snail] goes inside, over.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER DEFAULT_LOCALE="de" LINGUISTIC_TYPE_REF="bf" PARENT_REF="Transcription-txt-msn" TIER_ID="Translation-gls-bi">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a19" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Snel ia i stap kalkal wetem bel blong hem.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Hem i godaon ... kamdaon long samting ia, hem i lukim boks.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a21" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Hem i stap kalkal antap.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a22" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Kalkal antap, kalkal antap, kalkal antap</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a23" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Hem i kasem antap.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a24" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>Hem i kalkal, hem ... nao ia [boks ia] hem i open, mo [snel ia] i bin go insaed, finis.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
