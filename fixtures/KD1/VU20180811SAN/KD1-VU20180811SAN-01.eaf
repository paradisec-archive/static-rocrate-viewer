    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Godfrey Manar" TIER_ID="Transcription-txt-msn">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>O tok ni gogoro o tan̄sar, o tan̄sar me-rem kal, ni burgōr den e o mete gëvur e ni vērēg me ine, ni stop.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>E ni ēl o taēka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>E ni qeneg.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>E ni ek titiwial lō kēl, kal lō, ek titiwial kēl, kal lō, mete gëvur mo-lok den nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>E ni rön̄un lō, ni lokem wurveg ren o mete gëvur. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>E ni ēl o taēka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Taēka mōvōt.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>E in̄ko ni le lō o gogov.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Ni gial vita ni gial ta taēka ta taēka ni dödöm vita o tan̄sar la-varē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>E ni ek titiwial lin̄ereg kēl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Kal lin̄ereg kēl, kal lin̄ereg, kal lin̄ereg.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Ni wiak o vo ine e ni rēv lō, ni ēl o laion.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>E ni burgōr wōr kēl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>E ni sig-siag, ni sig-siag, ni wot-wojim o taēka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>E ni rivës e, ni rivës, e ni da më-m̄ës e ni soko, ni soko qēt.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Mem sur rōrōn̄.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>E ni tōrak, ni ēl kēl o taēka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>E o tok ni tōr-tōr sur nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>E ni gis gōr na qōtōn.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>E ni qaq lo-tok vita ni tarōn̄.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>E ni gial o tok ni taq rōrōn̄.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Tok gö-mörös ni gar nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>E ni gö-mörös ni var o tok, ni qeneg o laion, wo ni var o tok.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>O tok ma-gar nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>O tan̄sar ni van me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>E qēt.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>O tan̄sar ni van me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>E ni stop kēti, e ni var tul o reqe.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>E ni kër na vōlōn e ni tōrak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>E ni le o vo ine sër o taēka, sër o taēka, sër o laion, ni sum o bē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Laion ine ni sër-sër nē, ni sum-sum o bē, ni qeneg o laion, vērēg o mete gëvur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>Laion ine tōrak, ni ēl nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>Van sōw sur nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>ēl ne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>E ni van kēl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>E miti-big le nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>Van kēl wōl, ni ōn sur, van kēl wōl, ni ōn sur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>E ni tur-tur, mete gëvur mo-lok, qas mē-liar gōr nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>Ni dö-dödöm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>ēl o laion, ni tanem nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>E ni tur-tur, ni gis o mete gë... aēan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>Reqe mō-tōrak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>E in̄ko o reqe mē-vērēg, ēl nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>Qaq min nē:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>Vērēg me, wiak den nē o mete gevur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>Qaq kēl min nē vita wiak o mete gevur, kal lō den o laion.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>E ba ni ēl o laion, qaq la-laion, van sōw sur o laion.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>Van, o laion mo-goro nē, vērēg lō, burgōr o mete gevur, vērēg. </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>Reqe mö-burgōr qēt, vērēg tatag kēl nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>Rōw XXX rōw ine sēk nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>ēl ni me-rem, rōw kal.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>Qaq min nē vita ni sōw.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>ēl ni wo ni da timiak ine ni diam taq qërët.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>E ni qaq min nē vita nēk i sōw.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>E ni gë-tëkër.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>E wo ni sōw.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>Sōw o dēn̄ sōwe, qaq le-reqe tōrak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a125" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>ēl o tok, tok goro kēl nē, tok goro nē van rōw kēl, rōw kal kēl sar, ēl kēl o laion.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a126" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>E ni qeneg kal kēl lē-sēm gevur sōw o laion aē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a127" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>ēl o laion ek titiwial kēl, ek rōw ine.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a128" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>Ek ine, van lō ine, va-va-van.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a129" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>E ni qeneg kēl o laion.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a130" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>E ni lokem kēl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a131" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>Lokem kēl o vo mete gevur so o laion lö-lölö e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a132" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>E ni le o gogov gial kēl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
