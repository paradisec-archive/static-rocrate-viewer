    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="t" PARENT_REF="ref" PARTICIPANT="Godfrey Manar" TIER_ID="Transcription-txt-msn">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>I vo e me-rem kal siag lo-vo e, rōrō a sesesen̄ o boks.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>Rōrō o mörös a sesesen̄, sesesen̄ XXX tēqēl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>Ko rōrō a sēsēn̄, sesen̄, sesen̄.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>Sesen̄ vaa-van, sesen̄ dēn̄ me leta, e vo ine pusum tēqēl me o wiljea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Pusum tēqēl me, pusum tēqēl me, vo ine ni rev-rev nē, rōrō a ēl nē, sër o at, sër kēl na non o at.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>E rōrō a sesen̄ den ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>sesen̄ den i vo e, ni mörös ni le den, ni mörös ni pusum lebga so o vo e ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>e rōrō a qaq min nē rōrō a lian gōr o vo e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>In̄ko rōrō mörös a vivir den nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>Van me sesen̄ den nē, sesen̄.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>Wo o vo lekē ma-van kēl ren lo-totonon a vērēg tatag kēl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Vērēg, vērēg, vērēg vaa-van, rōrō a vērēg den kēl siag e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>O vo e mō-sōw kēl lo-leta wo rōrō vērēg tēqēl me, vērēg tēqēl me vaa-van</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Wo ine pusum sōw o wiljea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>So ne rōrō sas kal kēl.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Sas kal sar, sas kal sar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>E rōrō a mem den la-saed </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>E vo e ni pusum van tas, ni van tas, borseg rōrō.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Vo ine borborseg rōrō.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Borseg rōrō, borseg rōrō, borseg rōrō,, borseg rōrō vaa-van.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>E ni run̄un sōw lo vo e wo e ni kik nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>E kik nē qēt ni slavem na n̄ōsōn.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Slavem na valan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>E vo in̄kē ni borseg nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a121" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>Borseg nē, borseg nē ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a122" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>borseg nē vaa-van.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a123" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>E ni le den nē o at e ni bōl nē.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a124" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>Sër kēl siag min nē o at, qaq min rōrō.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
